# Configuracion de conexion a MariaDB / MySQL (plantilla segura)
# Copia este archivo como .env y define las credenciales reales en tu entorno local.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parcial

# Credenciales de cuentas tecnicas por rol en MariaDB
DB_ADMIN_USER=admin_db
DB_ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN

DB_CAJERO_USER=cajero_app
DB_CAJERO_PASSWORD=CAMBIAR_CLAVE_CAJERO

# Activar (1) solo en entorno local de demostracion para habilitar botones de acceso rapido
ENABLE_DEMO_QUICK_LOGIN=0

